{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/nhs-evidence/watch.schema.json",
  "title": "NHS Watch",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id", "title", "status", "watch_reason", "source_ids", "evidence_ids",
    "expected_event", "expected_by", "next_check", "last_checked", "last_result"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^WATCH-NHS-[0-9]{4}-[0-9]{4}$"},
    "title": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["open", "due", "satisfied", "closed", "superseded"]},
    "watch_reason": {"type": "string", "minLength": 1},
    "source_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "related_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "expected_event": {"type": "string", "minLength": 1},
    "expected_by": {"type": ["string", "null"], "format": "date"},
    "next_check": {"type": ["string", "null"], "format": "date"},
    "last_checked": {"type": ["string", "null"], "format": "date-time"},
    "last_result": {
      "type": ["string", "null"],
      "enum": ["not-checked", "no-change", "changed", "satisfied", "source-unavailable", null]
    },
    "closure_reason": {"type": ["string", "null"]}
  }
}
